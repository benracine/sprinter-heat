flowchart TB
  subgraph now["Today — master On · fans follow the dial"]
    direction TB
    MC["Master On"]
    FC["Branch C fuse"]
    DIAL["Speed dial<br/>SERIES on shared +"]
    N1["Noctua #1"]
    N2["Noctua #2"]
    MC --> FC --> DIAL
    DIAL -->|"PARALLEL"| N1
    DIAL -->|"PARALLEL"| N2
    NOTE["Fans can spin with master On<br/>even if heater is idle"]
  end

  subgraph later["After Q-022 — one relay, two jobs"]
    direction TB
    MB["Master On"]
    FB["Branch B fuse"]
    R["SC1600B R"]
    W["SC1600B W"]
    COIL["Relay COIL"]
    GND["Ground"]
    FC2["Branch C fuse"]
    CONT["Relay CONTACTS<br/>SERIES in fan +"]
    DIAL2["Speed dial"]
    NP["Noctua #1 ∥ #2"]
    WAKE["Approved wake input<br/>pin TBD — Q-022"]

    MB --> FB --> R
    R -->|"Heat: contact closes"| W
    W --> COIL --> GND
    W -.->|"same closure<br/>(parallel from contact)"| WAKE
    MB --> FC2 --> CONT --> DIAL2 --> NP
  end

  subgraph topo["Relay placement"]
    direction TB
    R1["Coil loop SERIES: + → fuse → R–W → coil → ground"]
    R2["Fan power SERIES: + → fuse → contacts → dial → fans"]
    R3["Two Noctuas PARALLEL after the dial"]
    R4["Espar vehicle-blower relay = NOT used"]
  end

  classDef solid fill:#f5f5f4,stroke:#57534e,stroke-width:1px,color:#1c1917;
  classDef open fill:#eeeeec,stroke:#78716c,stroke-width:2px,stroke-dasharray:4 3,color:#1c1917;
  class MC,FC,DIAL,N1,N2,NOTE solid;
  class MB,FB,R,W,COIL,GND,FC2,CONT,DIAL2,NP,WAKE open;
